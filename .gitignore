# Other
/keys
/buildServer.json

# Android bridge build artifacts. `bridge/` is a separate Gradle
# project; everything under build/, .gradle/ and local.properties is
# per-machine / regenerated by `scripts/build-bridge.sh`.
bridge/.gradle/
bridge/build/
bridge/app/build/
bridge/local.properties
bridge/.idea/
bridge/*.iml
bridge/app/*.iml
bridge/captures/

# Android playground fixture (standalone Gradle project under Playgrounds/).
Playgrounds/Android/.gradle/
Playgrounds/Android/build/
Playgrounds/Android/app/build/
Playgrounds/Android/local.properties
Playgrounds/Android/.idea/
Playgrounds/Android/**/*.iml
Playgrounds/Android/captures/

# The bridge APK is a build output, not a source artifact. The Swift
# `AndroidBackend` target loads it from `Sources/AndroidBackend/Resources/`
# at runtime; populate that path locally via `scripts/build-bridge.sh`.
# `swift build` succeeds without it; `sim-use android init` then prints
# a clear "build the bridge first" error.
Sources/AndroidBackend/Resources/*.apk

# Staged copy of `ios-bridge/` that the `iOSDeviceBackend` target ships as
# a resource so a released binary can build the runner on a user's
# machine. Generated by `scripts/build-ios-bridge.sh`; the source of
# truth is the top-level `ios-bridge/` directory.
Sources/iOSDeviceBackend/Resources/ios-bridge/

# ...but the bridge's own Xcode project IS tracked, despite the blanket
# `*.xcodeproj` rule at the top of this file. It is a shipped source
# artifact, not build output: contributors need only Xcode (no
# xcodegen), `sim-use ios-device init` builds the runner from it on the
# user's machine, and `release-artifacts.sh verify-stage` fails the
# release if `project.pbxproj` is absent from the staged bundle.
# Per-user Xcode state stays ignored.
!ios-bridge/SimUseDeviceBridge.xcodeproj/
!ios-bridge/SimUseDeviceBridge.xcodeproj/project.xcworkspace/
ios-bridge/SimUseDeviceBridge.xcodeproj/xcuserdata/
ios-bridge/SimUseDeviceBridge.xcodeproj/project.xcworkspace/xcuserdata/

# The Viewer SPA is a build output, not a source artifact. Source lives
# in Tools/Viewer/; regenerate the bundled tree via `make viewer` (or
# `scripts/build-viewer.sh`). `swift build` succeeds without the dist;
# `sim-use viewer` then prints a clear "build the Viewer first" error.
# `.gitkeep` is tracked so SwiftPM `.copy("Resources/viewer")` always
# has a directory to copy.
# Bundled skill (source of truth: skills/sim-use/; synced by `make build`)
Sources/SimUse/Resources/skills/sim-use/

Sources/SimUse/Resources/viewer/*
!Sources/SimUse/Resources/viewer/.gitkeep
*.profraw

# Agent-eval run artifacts (reports, transcripts, screenshots).
/e2e/agent-evals/reports/

# Python bytecode from eval harness.
__pycache__/
*.pyc
